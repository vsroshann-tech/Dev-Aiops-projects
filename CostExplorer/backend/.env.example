# AI Provider configuration (set ONE of the following)
OPENAI_API_KEY=sk-your-openai-api-key-here
# Free alternatives (no credit card required):
# GROQ_API_KEY=gsk_your-groq-api-key-here
# GEMINI_API_KEY=AIzaYour-gemini-api-key-here
# Or any OpenAI-compatible endpoint (e.g. OpenRouter):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Amazon RDS PostgreSQL connection string (SSL/TLS enabled)
DATABASE_URL=postgresql://postgres:your-password@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/costdetective?sslmode=require

# Custom JWT authentication secret (generate a strong random string for production)
JWT_SECRET=change-me-to-a-long-random-secret-key
# JWT_EXPIRE_HOURS=24

# Optional SSL settings for RDS (require | verify-ca | verify-full | disable)
# DB_SSL_MODE=require
# DB_SSL_ROOT_CERT=/path/to/global-bundle.pem

# Optional overrides
OPENAI_MODEL=gpt-4o
DEMO_MODE=false
# AWS_REGION=us-east-1
# CORS_ORIGINS=http://localhost:5173

# Caller credentials for local sts:AssumeRole (not needed on EC2/ECS with an instance role)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
