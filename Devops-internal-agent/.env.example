# ==============================================================================
# Internal DevOps AI Agent - Security-Compliant POC Configuration
# ==============================================================================
# Mode: "mock" (safe local Ubuntu POC with realistic simulated AWS/GitHub/DB data)
#       "live" (connects to real GitHub Actions, AWS, MySQL, and Postgres)
POC_MODE=mock

# Server & Auth
APP_HOST=0.0.0.0
APP_PORT=8005
# Comma-separated API keys for Retool & internal callers (change before production!)
API_KEYS=dev-retool-poc-key-change-me
REQUIRE_AUTH=true

# Data & Compliance Storage (local persistent files on Ubuntu/disk)
DATA_DIR=./data
SKILLS_DIR=./skills
AUDIT_LOG_PATH=./data/audit_logs.jsonl
VECTOR_DB_PATH=./data/rag_store.db

# LLM Provider: "local_fallback" | "ollama" | "openai_compatible"
# For secret company docs, prefer "ollama" (100% local) or private VPC endpoint.
LLM_PROVIDER=local_fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional OpenAI-compatible private gateway (e.g. LiteLLM / vLLM / Bedrock proxy)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Security & Compliance Controls
ENABLE_SECRET_REDACTION=true
READ_ONLY_DB_ENFORCED=true
ALLOW_CI_MUTATIONS=false
MAX_RAG_RESULTS=4

# GitHub Actions (used when POC_MODE=live)
GITHUB_TOKEN=
GITHUB_DEFAULT_ORG=my-company
GITHUB_DEFAULT_REPO=platform-infra

# AWS Infrastructure (used when POC_MODE=live)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Databases (used for read-only diagnostics when POC_MODE=live, or local Docker POC)
POSTGRES_DSN=postgresql://devops_ro:devops_ro_pass@localhost:5432/app_prod_ro
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=devops_ro
MYSQL_PASSWORD=devops_ro_pass
MYSQL_DATABASE=orders_ro
